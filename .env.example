# === Database ===

# Local development: Docker Compose Postgres
DATABASE_URL="postgresql://matchboard:matchboard@localhost:5432/matchboard?schema=public"
DIRECT_URL="postgresql://matchboard:matchboard@localhost:5432/matchboard?schema=public"

# Production: Neon Postgres (override these in Vercel environment variables)
# DATABASE_URL uses matchboard_app role (restricted by RLS, for runtime queries)
# DIRECT_URL uses matchboard_admin role (BYPASSRLS, for Prisma migrations only)
# DATABASE_URL="postgresql://matchboard_app:APP_PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL="postgresql://matchboard_admin:ADMIN_PASSWORD@HOST.REGION.neon.tech/DB?sslmode=require"

# Tests: separate DB so test data never touches production data
# REQUIRED: tests will not run without TEST_DATABASE_URL set — it never falls back to DATABASE_URL
# TEST_DATABASE_URL="postgresql://matchboard:matchboard@localhost:5432/matchboard_test?schema=public"

# === Authentication ===

# Generate with: npx auth secret
AUTH_SECRET="replace-with-generated-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Base URL for auth callbacks (http://localhost:3333 for local, https://your-domain.vercel.app for production)
AUTH_URL="http://localhost:3333"

# Comma-separated allowlist of coach email addresses (case-insensitive)
ALLOWED_COACH_EMAILS="coach1@example.com,coach2@example.com"

# === Transactional email (Brevo) ===

# Brevo API key for transactional email delivery.
# When absent, emails are logged to console instead of being sent.
# Required in production. Get from https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=""

# Brevo webhook key for verifying delivery status callbacks.
# When absent, webhook signature verification is skipped (local dev only).
# Generate in Brevo webhook settings.
# BREVO_WEBHOOK_KEY=""

# Sender email address for transactional emails.
# Defaults to "notifications@matchboard.football" if not set.
# EMAIL_FROM_ADDRESS="notifications@matchboard.football"

# Sender name for transactional emails.
# Defaults to "Matchboard" if not set.
# EMAIL_FROM_NAME="Matchboard"

# Public base URL of the application, used for generating links in email templates.
# Required in production. Example: https://app.matchboard.football
# APP_BASE_URL="http://localhost:3333"

# === Cron authentication ===

# Shared secret for verifying Vercel Cron requests.
# Required in production. Generate with: openssl rand -hex 32
# CRON_SECRET=""

# === Preview deployment protection ===

# Comma-separated email allowlist for Vercel preview deployments.
# When set on preview deployments, only allowlisted emails can access preview API routes.
# When empty or unset, all authenticated coaches can access preview API routes.
# PREVIEW_ALLOWLIST_EMAILS="coach1@example.com"

# === Neon CLI ===

# Neon API key for branch management and operational queries.
# Scoped to the Matchboard Neon project where possible.
# Get from https://console.neon.tech/app/settings
# NEON_API_KEY=""

# === Vercel CLI ===

# Vercel deployment token (secret).
# Get from https://vercel.com/account/tokens
# VERCEL_TOKEN=""

# Vercel organisation and project identifiers (not secrets, but treat as internal).
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID=""

# === Cloudflare DNS ===

# Cloudflare API token scoped to the matchboard.football zone.
# Required permissions: Zone:Read, DNS:Edit
# Get from https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=""

# Cloudflare account and zone identifiers (not secrets, but treat as internal).
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ZONE_ID=""

# === Brevo CLI ===

# Brevo API key for transactional email and operational queries.
# Get from https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=""

# Brevo webhook key for verifying delivery status callbacks.
# BREVO_WEBHOOK_KEY=""

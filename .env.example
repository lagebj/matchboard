# === Database ===

# Local development: Docker Compose Postgres
DATABASE_URL="postgresql://matchboard:matchboard@localhost:5432/matchboard?schema=public"
DIRECT_URL="postgresql://matchboard:matchboard@localhost:5432/matchboard?schema=public"

# Production: Neon Postgres (override these in Vercel environment variables)
# DATABASE_URL uses matchboard_app_runtime role (restricted by RLS, NOBYPASSRLS, for runtime queries)
#   Uses the pooled connection (-pooler) for connection multiplexing.
#   IMPORTANT: SET LOCAL inside Prisma transactions does NOT work with the Neon adapter.
#   Tenant isolation uses where-clause injection (see db.ts), not SET LOCAL session variables.
# DIRECT_URL uses matchboard_admin_migration role (NOBYPASSRLS, admin_all RLS policy, for Prisma migrations)
# DIRECT_RUNTIME_URL (optional) overrides the runtime database connection for local dev.
#   If not set, the app uses DATABASE_URL directly for runtime queries.
# NOTE: Do NOT use the legacy matchboard_app or matchboard_admin Console-created roles —
# they inherit BYPASSRLS from neon_superuser, making RLS ineffective.
# DATABASE_URL="postgresql://matchboard_app_runtime:APP_PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL="postgresql://matchboard_admin_migration:ADMIN_PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_RUNTIME_URL="postgresql://matchboard_app_runtime:APP_PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
# PRODUCTION_DATABASE_URL="postgresql://matchboard_app_runtime:APP_PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Tests: separate DB so test data never touches production data
# REQUIRED: tests will not run without TEST_DATABASE_URL set — it never falls back to DATABASE_URL
# For local PostgreSQL (docker compose): postgresql://matchboard:matchboard@localhost:5432/matchboard_test?schema=public
# For local PostgreSQL (user-owned): postgresql://matchboard@localhost:5433/matchboard_test?schema=public
# For Neon: postgresql://user:pass@host.neon.tech/db?sslmode=require
# Local Postgres is recommended when available (near-zero latency, matches CI exactly). If
# pointing at a Neon branch, see docs/development/test-architecture.md's "cleanTestDb()
# performance" section — a one-time TRUNCATE grant avoids a significant slowdown from network
# round trips.
TEST_DATABASE_URL="postgresql://matchboard:matchboard@localhost:5432/matchboard_test?schema=public"
# Direct URL for Prisma migrations in test/CI. Falls back to TEST_DATABASE_URL if not set.
# For local PostgreSQL (docker compose): postgresql://matchboard:matchboard@localhost:5432/matchboard_test?schema=public
# For local PostgreSQL (user-owned): postgresql://matchboard@localhost:5433/matchboard_test?schema=public
TEST_DATABASE_DIRECT_URL="postgresql://matchboard:matchboard@localhost:5432/matchboard_test?schema=public"

# === Application environment ===

# MATCHBOARD_ENV explicitly identifies the runtime environment.
# Values: development | test | staging | production
# When unset, inferred from NODE_ENV (development→development, test→test, production→production).
# Recommended: set explicitly in all deployed environments.
# MATCHBOARD_ENV="production"

# === Authentication ===

# Generate with: npx auth secret
AUTH_SECRET="replace-with-generated-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Base URL for auth callbacks (http://localhost:3333 for local, https://your-domain.vercel.app for production)
AUTH_URL="http://localhost:3333"

# === Transactional email (Brevo) ===

# Brevo API key for transactional email delivery.
# When absent, emails are logged to console instead of being sent.
# Required in production. Get from https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=""

# Brevo test recipient allowlist (comma-separated emails).
# In non-production environments, Brevo only sends to these addresses.
# If not set in non-production, all Brevo sends are blocked.
# Not used in production — all recipients receive real email.
# BREVO_TEST_RECIPIENTS="test@example.com,dev@example.com"

# Brevo webhook key for verifying delivery status callbacks.
# BREVO_WEBHOOK_KEY is DEPRECATED. Use BREVO_WEBHOOK_BEARER_TOKEN instead.
# When absent, webhook bearer token verification is skipped (local dev only).
# Generate a secure random token and configure it in Brevo webhook settings.
# BREVO_WEBHOOK_KEY=""
# BREVO_WEBHOOK_BEARER_TOKEN=""

# Sender email address for transactional emails.
# Defaults to "notifications@matchboard.football" if not set.
# EMAIL_FROM_ADDRESS="notifications@matchboard.football"

# Sender name for transactional emails.
# Defaults to "Matchboard" if not set.
# EMAIL_FROM_NAME="Matchboard"

# Public base URL of the application, used for generating links in email templates.
# Required in production. Example: https://app.matchboard.football
# APP_BASE_URL="http://localhost:3333"

# === Cron authentication ===

# Shared secret for verifying Vercel Cron requests.
# Required in production. Generate with: openssl rand -hex 32
# CRON_SECRET=""

# === Preview deployment protection ===

# Comma-separated email allowlist for Vercel preview deployments.
# When set on preview deployments, only allowlisted emails can access preview API routes.
# When empty or unset, all authenticated coaches can access preview API routes.
# PREVIEW_ALLOWLIST_EMAILS="coach1@example.com"

# === Test-only agent authentication ===

# Enable deterministic test-only authentication via Auth.js Credentials provider.
# ONLY valid when MATCHBOARD_ENV=test. Setting this in production causes startup failure.
# This authenticates a real persisted User through normal Auth.js session flow.
# Authorization (membership, group access) remains unchanged.
# TEST_AGENT_AUTH_ENABLED=true

# Secret for test agent authentication.
# Required when TEST_AGENT_AUTH_ENABLED=true. Must differ from AUTH_SECRET.
# Only valid when MATCHBOARD_ENV=test. Setting this in production causes startup failure.
# Generate with: openssl rand -hex 32
# TEST_AGENT_AUTH_SECRET=""

# Email namespace for test agent authentication.
# Only emails ending in @<namespace> are accepted by test agent auth.
# Defaults to "test-agent.matchboard.football" if not set.
# TEST_AGENT_AUTH_NAMESPACE="test-agent.matchboard.football"

# === Synthetic test dataset ===

# Version identifier for the canonical synthetic test dataset.
# Displayed by /api/meta for environment identification.
# TEST_DATASET_VERSION="1"

# === Neon CLI ===

# Neon API key for branch management and operational queries.
# Scoped to the Matchboard Neon project where possible.
# Get from https://console.neon.tech/app/settings
# NEON_API_KEY=""

# === Vercel CLI ===

# Vercel deployment token (secret).
# Get from https://vercel.com/account/tokens
# VERCEL_TOKEN=""

# Vercel organisation and project identifiers (not secrets, but treat as internal).
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID=""

# === Cloudflare DNS ===

# Cloudflare API token scoped to the matchboard.football zone.
# Required permissions: Zone:Read, DNS:Edit
# Get from https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=""

# Cloudflare account and zone identifiers (not secrets, but treat as internal).
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ZONE_ID=""

# === Brevo CLI ===

# Brevo API key for transactional email and operational queries.
# Get from https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=""

# Brevo webhook bearer token for verifying delivery status callbacks.
# BREVO_WEBHOOK_KEY is DEPRECATED — use BREVO_WEBHOOK_BEARER_TOKEN instead.
# BREVO_WEBHOOK_KEY=""
# BREVO_WEBHOOK_BEARER_TOKEN=""

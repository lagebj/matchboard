{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      // Mirrors the root tsconfig's `@/*` alias so shared modules under `src/lib/live-match/`
      // (imported by relative path from this project, per SPEC.md §14) resolve their own
      // internal `@/*` imports (e.g. `live-match-types.ts` -> `@/generated/prisma/client`,
      // type-only) the same way the main app resolves them.
      "@/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}

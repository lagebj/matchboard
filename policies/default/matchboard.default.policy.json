{
  "id": "matchboard-default-v1",
  "name": "Matchboard Default Policy",
  "version": "1.0.0",
  "description": "Default eligibility, warning, and scoring rules for Matchboard squad selection. This policy always runs alongside any custom policy.",
  "rules": [
    {
      "id": "deny-removed-players",
      "effect": "deny",
      "when": {
        "all": [
          { "field": "player.status", "op": "eq", "value": "REMOVED" }
        ]
      },
      "reason": "Removed players cannot be selected."
    },
    {
      "id": "deny-inactive-players",
      "effect": "deny",
      "when": {
        "all": [
          { "field": "player.status", "op": "eq", "value": "INACTIVE" }
        ]
      },
      "reason": "Inactive players cannot be selected."
    },
    {
      "id": "deny-unavailable-players",
      "effect": "deny",
      "when": {
        "all": [
          { "field": "player.availableForContext", "op": "eq", "value": false }
        ]
      },
      "reason": "Unavailable players cannot be selected for this context."
    },
    {
      "id": "warn-no-primary-goalkeeper",
      "effect": "warning",
      "when": {
        "all": [
          { "field": "squad.primaryGoalkeeperCount", "op": "eq", "value": 0 }
        ]
      },
      "warning": {
        "code": "no_primary_goalkeeper",
        "severity": "warning",
        "message": "Squad has no primary goalkeeper."
      }
    },
    {
      "id": "prioritize-low-recent-match-count",
      "effect": "score_adjustment",
      "when": {
        "all": [
          { "field": "player.recentMatchCount", "op": "lte", "value": 1 }
        ]
      },
      "scoreAdjustment": 5,
      "reason": "Player has had fewer recent match opportunities."
    },
    {
      "id": "prioritize-low-period-match-count",
      "effect": "score_adjustment",
      "when": {
        "all": [
          { "field": "player.periodMatchCount", "op": "lte", "value": 1 }
        ]
      },
      "scoreAdjustment": 3,
      "reason": "Player has had fewer period match opportunities."
    },
    {
      "id": "prioritize-low-season-match-count",
      "effect": "score_adjustment",
      "when": {
        "all": [
          { "field": "player.seasonMatchCount", "op": "lte", "value": 2 }
        ]
      },
      "scoreAdjustment": 2,
      "reason": "Player has had fewer season match opportunities."
    }
  ]
}

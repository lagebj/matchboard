generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id                       String           @id @default(cuid())
  name                     String           @unique
  targetSquadSize          Int              @default(11)
  minAcceptedSquadSize     Int              @default(9)
  maxSquadSize             Int              @default(14)
  minCorePlayers           Int              @default(8)
  minSupportCount          Int              @default(0)
  targetSupportCount       Int              @default(0)
  maxSupportCount          Int              @default(0)
  maxPlayerChangesPerRound Int              @default(0)
  supportPriority          Int              @default(0)
  minSupportPlayers        Int              @default(0)
  developmentSlots         Int              @default(0)
  archivedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  formations               Formation[]
  matches                  Match[]
  lineups                  MatchLineup[]
  ledgerFromTeam           MovementLedger[] @relation("LedgerFromTeam")
  ledgerToTeam             MovementLedger[] @relation("LedgerToTeam")
  corePlayers              Player[]         @relation("CoreTeam")
  fromRotationPaths        RotationPath[]   @relation("FromTeam")
  toRotationPaths          RotationPath[]   @relation("ToTeam")
  teamSeasonSnapshots     TeamSeasonSnapshot[]

  @@index([archivedAt, name])
}

model Player {
  id                      String                    @id @default(cuid())
  playerCode              Int                       @unique
  shirtNumber             Int?
  firstName               String
  lastName                String?
  active                  Boolean                   @default(true)
  removedAt               DateTime?
  coreTeamId              String?
  nonRotatable            Boolean                   @default(false)
  reducedMatchLoadAllowed Boolean                   @default(false)
  supportSuitability      String                    @default("neutral")
  developmentReadiness    String                    @default("neutral")
  primaryPosition         String
  secondaryPosition       String?
  tertiaryPosition        String?
  preferredFoot           FootPreference
  secondaryFoot           SecondaryFoot
  bestSide                BestSide
  currentAvailability     AvailabilityStatus        @default(AVAILABLE)
  supportNoShowCount      Int                       @default(0)
  ballControl             Int?
  passing                 Int?
  firstTouch              Int?
  oneVOneAttacking        Int?
  positioning             Int?
  oneVOneDefending        Int?
  decisionMaking          Int?
  effort                  Int?
  teamplay                Int?
  concentration           Int?
  speed                   Int?
  strength                Int?
  notes                   String?
  supportInstruction      String?
  developmentInstruction  String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  goalkeeperAbility       GoalkeeperAbility         @default(NO)
  lastRatedAt             DateTime?
  assists                 Assist[]
  availabilities          Availability[]
  eventAvailability       EventPlayerAvailability[]
  eventSquadPlayers       EventSquadPlayer[]
  goals                   Goal[]
  executionFeedback       MatchExecutionFeedback[]
  matchReportAbsences     MatchReportAbsence[]
  matchReportStats        MatchReportPlayerStat[]
  movementCandidates      MovementCandidate[]
  ledgerEntries           MovementLedger[]
  coreTeam                Team?                     @relation("CoreTeam", fields: [coreTeamId], references: [id], onDelete: Restrict)
  locks                   PlayerLock[]
  positions               PlayerPosition[]
  readinessSignals        PlayerReadinessSignal[]
  postMatchActuals        PostMatchPlayerActual[]
  selections              Selection[]
  eventPostMatchPlayers   EventPostMatchPlayer[]
  eventGoalEvents        EventGoalEvent[]        @relation("EventGoalScorer")
  eventAssistEvents      EventAssistEvent[]       @relation("EventAssistProvider")
  eventSupportAssignments EventMatchSupportAssignment[]
  eventLineupAssignments EventMatchLineupAssignment[]
  playerSeasonSnapshots TeamSeasonSnapshotPlayer[]

  @@index([coreTeamId, active, removedAt])
  @@index([removedAt, firstName, lastName])
}

model Match {
  id                          String                        @id @default(cuid())
  matchRoundId                String
  teamId                      String
  opponent                    String
  startsAt                    DateTime
  homeAway                    MatchVenue
  squadSize                   Int                           @default(11)
  availableForDevelopmentSlot Boolean                       @default(false)
  matchType                   MatchType                     @default(FRIENDLY)
  gameFormat                  GameFormat                    @default(ELEVEN_A_SIDE)
  formation                   String?
  matchFit                    MatchFit                      @default(UNKNOWN)
  notes                       String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  opponentTeamId              String
  status                      MatchStatus                   @default(SCHEDULED)
  cancelledAt                 DateTime?
  cancelledReason             String?
  category                    MatchCategory                 @default(LEAGUE)
  matchRound                  MatchRound                    @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  opponentTeam                OpponentTeam                  @relation(fields: [opponentTeamId], references: [id])
  team                        Team                          @relation(fields: [teamId], references: [id])
  executionFeedback           MatchExecutionFeedback[]
  lineups                     MatchLineup[]
  movementLedger              MovementLedger[]
  opponentObservation         OpponentEncounterObservation?
  selections                  Selection[]
  teamReflection              TeamReflection?

  @@index([startsAt, createdAt])
  @@index([opponentTeamId])
  @@index([category])
}

model OpponentTeam {
  id             String                         @id @default(cuid())
  displayName    String
  normalizedName String                         @unique
  archivedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  matches        Match[]
  eventMatches   EventMatch[]
  observations   OpponentEncounterObservation[]

  @@index([archivedAt, displayName])
}

model RuleConfig {
  id                       String   @id @default(cuid())
  version                  Int      @default(1)
  name                     String   @default("Default ruleset")
  minDaysBetweenAnyMatches Int      @default(3)
  warningThreshold         Int      @default(5)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Season {
  id            String         @id @default(cuid())
  name          String
  year          Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leagueSeasons LeagueSeason[]

  @@map("Season")
}

model MatchRound {
  id              String           @id @default(cuid())
  name            String
  leagueSeasonId  String
  status          String           @default("DRAFT")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  availabilities  Availability[]
  matches         Match[]
  leagueSeason    LeagueSeason     @relation(fields: [leagueSeasonId], references: [id])
  movementLedger   MovementLedger[]
  playerLocks      PlayerLock[]
  selections       Selection[]
  warnings         Warning[]

  @@index([leagueSeasonId])
  @@map("MatchRound")
}

model Availability {
  id           String     @id @default(cuid())
  playerId     String
  matchRoundId String
  status       String
  note         String?
  createdAt    DateTime   @default(now())
  matchRound   MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
}

model Selection {
  id                     String                      @id @default(cuid())
  matchId                String
  matchRoundId           String
  playerId               String
  role                   SelectionRole
  controlledDoubleLoad   Boolean                     @default(false)
  status                 SelectionStatus             @default(DRAFT)
  ruleConfigVersion      Int?
  explanation            Json?
  overrideReason         String?
  overrideReasonCategory OverrideReasonCategory?
  overrideReasonDetail   String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  matchdayResponsibility MatchdayResponsibilityType?
  match                  Match                       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchRound             MatchRound                  @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player                 Player                      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  audits                 SelectionAudit[]
}

model RotationPath {
  id                      String              @id @default(cuid())
  fromTeamId              String
  toTeamId                String
  role                    SelectionRole
  purpose                 String
  minimumCount            Int?
  targetCount             Int?
  maximumCount            Int?
  cooldownRounds          Int?
  priority                Int?
  active                  Boolean             @default(true)
  allowDoubleLoad         Boolean             @default(false)
  minRestSpacingHours     Int?
  maxDoubleLoadsPerPeriod Int?
  movementCandidates      MovementCandidate[]
  fromTeam                Team                @relation("FromTeam", fields: [fromTeamId], references: [id])
  toTeam                  Team                @relation("ToTeam", fields: [toTeamId], references: [id])
}

model MovementLedger {
  id                   String        @id @default(cuid())
  matchRoundId         String
  matchId              String
  playerId             String
  fromTeamId           String
  toTeamId             String
  role                 SelectionRole
  controlledDoubleLoad Boolean       @default(false)
  reason               String?
  explanation          String?
  isDraft              Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  fromTeam             Team          @relation("LedgerFromTeam", fields: [fromTeamId], references: [id])
  match                Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchRound           MatchRound    @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player               Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  toTeam               Team          @relation("LedgerToTeam", fields: [toTeamId], references: [id])

  @@index([matchRoundId, matchId])
  @@index([playerId])
}

model Formation {
  id              String          @id @default(cuid())
  name            String
  gameFormat      GameFormat
  source          FormationSource @default(SYSTEM)
  teamId          String?
  createdByUserId String?
  description     String?
  isArchived      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  eventSquads     EventSquad[]
  team            Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slots           FormationSlot[]
  lineups         MatchLineup[]
  eventLineups    EventMatchLineup[]

  @@index([gameFormat])
  @@index([teamId])
  @@index([source, isArchived])
}

model FormationSlot {
  id                  String                @id @default(cuid())
  formationId         String
  gridX               Int
  gridY               Int
  label               String
  shortLabel          String
  roleType            FormationSlotRoleType
  acceptedPositionIds Json                  @default("[]")
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  formation           Formation             @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([formationId, gridX, gridY])
  @@index([formationId])
  @@index([formationId, sortOrder])
}

model MatchLineup {
  id                String                  @id @default(cuid())
  matchId           String
  teamId            String
  formationId       String?
  status            MatchLineupStatus       @default(DRAFT)
  formationSnapshot Json?
  benchPlayerIds    Json                    @default("[]")
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  formation         Formation?              @relation(fields: [formationId], references: [id])
  match             Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team              Team                    @relation(fields: [teamId], references: [id])
  assignments       MatchLineupAssignment[]

  @@index([matchId])
  @@index([teamId])
  @@index([status])
}

model MatchLineupAssignment {
  id            String                      @id @default(cuid())
  matchLineupId String
  slotId        String
  playerId      String?
  locked        Boolean                     @default(false)
  source        MatchLineupAssignmentSource @default(MANUAL)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  matchLineup   MatchLineup                 @relation(fields: [matchLineupId], references: [id], onDelete: Cascade)

  @@unique([matchLineupId, slotId])
  @@unique([matchLineupId, playerId])
  @@index([matchLineupId])
  @@index([playerId])
}

model PlayerPosition {
  id         String                 @id @default(cuid())
  playerId   String
  positionId String
  priority   PlayerPositionPriority @default(PRIMARY)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  player     Player                 @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([playerId, positionId])
  @@index([playerId])
  @@index([positionId])
}

model Warning {
  id           String          @id @default(cuid())
  matchRoundId String
  matchId      String?
  playerId     String?
  teamId       String?
  severity     WarningSeverity
  rule         String
  message      String
  resolved     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  matchRound   MatchRound      @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
}

model PlayerLock {
  id           String     @id @default(cuid())
  matchRoundId String
  playerId     String
  lockType     String
  reason       String?
  lockedBy     String?
  createdAt    DateTime   @default(now())
  matchRound   MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchRoundId, playerId])
}

model SelectionAudit {
  id             String    @id @default(cuid())
  selectionId    String
  changeReason   String
  previousRole   String?
  previousStatus String?
  changedAt      DateTime  @default(now())
  selection      Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@index([selectionId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DecisionRecord {
  id               String   @id @default(cuid())
  decisionType     String
  entityType       String
  entityId         String
  recommendationId String?
  action           String
  reason           String?
  createdBy        String
  createdAt        DateTime @default(now())
  beforeSnapshot   Json?
  afterSnapshot    Json?

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

model CoachingIntent {
  id        String                  @id @default(cuid())
  scopeType CoachingIntentScopeType
  scopeId   String
  category  CoachingIntentCategory
  note      String?
  createdBy String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([scopeType, scopeId])
  @@index([category])
}

model PostMatchReport {
  id            String                  @id @default(cuid())
  matchId       String                  @unique
  teamNote      String?
  completedBy   String?
  completedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  awayGoals     Int?
  homeGoals     Int?
  status        MatchReportStatus       @default(DRAFT)
  assists       Assist[]
  goals         Goal[]
  absences      MatchReportAbsence[]
  playerStats   MatchReportPlayerStat[]
  playerActuals PostMatchPlayerActual[]

  @@index([status])
}

model PostMatchPlayerActual {
  id                        String                     @id @default(cuid())
  matchId                   String
  playerId                  String
  attendanceStatus          String                     @default("UNKNOWN")
  actualPositions           Json?
  note                      String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  reportId                  String
  source                    String                     @default("PLANNED")
  unplannedAppearanceReason UnplannedAppearanceReason?
  player                    Player                     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  report                    PostMatchReport            @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([playerId])
  @@index([attendanceStatus])
}

model Goal {
  id        String          @id @default(cuid())
  reportId  String
  playerId  String?
  minute    Int?
  type      String          @default("NORMAL")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  player    Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  report    PostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([playerId])
}

model Assist {
  id        String          @id @default(cuid())
  reportId  String
  playerId  String
  type      String          @default("NORMAL")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  player    Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)
  report    PostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([playerId])
}

model MatchReportAbsence {
  id            String               @id @default(cuid())
  matchReportId String
  matchId       String
  playerId      String
  reason        PlannedAbsenceReason
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  report        PostMatchReport      @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
  player        Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchReportId, playerId])
  @@index([matchId])
  @@index([playerId])
}

model MatchReportPlayerStat {
  id            String          @id @default(cuid())
  matchReportId String
  playerId      String
  goals         Int             @default(0)
  assists       Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  report        PostMatchReport @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
  player        Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchReportId, playerId])
  @@index([playerId])
}

model PlayerReadinessSignal {
  id         String               @id @default(cuid())
  playerId   String
  signalType ReadinessSignalType
  value      ReadinessSignalValue
  note       String?
  recordedBy String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  player     Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([playerId, signalType])
  @@index([playerId])
  @@index([signalType])
}

model MatchExecutionFeedback {
  id                 String             @id @default(cuid())
  matchId            String
  playerId           String
  category           FeedbackCategory
  value              String
  observableBehavior String?
  nextAction         FeedbackNextAction @default(NO_ACTION)
  note               String?
  recordedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  match              Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player             Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchId, playerId, category])
  @@index([matchId])
  @@index([playerId])
  @@index([category])
}

model TeamReflection {
  id               String   @id @default(cuid())
  matchId          String   @unique
  effort           String?
  teamCohesion     String?
  positionalShape  String?
  recoveryBehavior String?
  note             String?
  recordedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model OpponentEncounterObservation {
  id                       String                      @id @default(cuid())
  matchId                  String                      @unique
  opponentTeamId           String
  overallEnvironment       MatchEnvironmentObservation @default(NOT_ASSESSED)
  opponentPlayersContext   MatchEnvironmentObservation @default(NOT_ASSESSED)
  opponentStaffContext     MatchEnvironmentObservation @default(NOT_ASSESSED)
  spectatorSidelineContext MatchEnvironmentObservation @default(NOT_ASSESSED)
  concernCategories        OpponentConcernCategory[]
  factualSummary           String?
  followUp                 OpponentObservationFollowUp @default(NONE)
  recordedBy               String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  match                    Match                       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  opponentTeam             OpponentTeam                @relation(fields: [opponentTeamId], references: [id])

  @@index([opponentTeamId, createdAt])
  @@index([overallEnvironment])
}

model SelectionExplanation {
  id                     String                      @id @default(cuid())
  scopeType              String
  scopeId                String
  matchId                String?
  teamId                 String?
  playerId               String?
  summary                String
  rulesApplied           Json
  blockers               Json
  warnings               Json
  recommendations        Json
  crossTeamImpacts       Json
  createdAt              DateTime                    @default(now())
  coachingIntentCategory CoachingIntentCategory?
  matchdayResponsibility MatchdayResponsibilityType?

  @@index([scopeType, scopeId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@index([createdAt])
}

model MovementCandidate {
  id                String                     @id @default(cuid())
  playerId          String
  rotationPathId    String
  role              MovementCandidateRole
  status            MovementCandidateStatus    @default(ACTIVE)
  activeFrom        DateTime                   @default(now())
  reviewBy          DateTime?
  rationaleCategory MovementCandidateRationale
  rationaleNote     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  player            Player                     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  rotationPath      RotationPath               @relation(fields: [rotationPathId], references: [id], onDelete: Cascade)

  @@unique([playerId, rotationPathId, role])
  @@index([playerId])
  @@index([rotationPathId])
  @@index([status])
}

model Event {
  id                     String                    @id @default(cuid())
  name                   String
  eventType              EventType                 @default(CUP)
  startsAt               DateTime
  endsAt                 DateTime?
  gameFormat             GameFormat
  defaultFormationId     String?
  matchDurationMinutes   Int?
  selectionPattern       EventSelectionPattern?
  notes                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  players                EventPlayerAvailability[]
  squads                 EventSquad[]
  eventMatches           EventMatch[]

  @@index([startsAt])
  @@index([eventType])
}

model EventPlayerAvailability {
  id        String            @id @default(cuid())
  eventId   String
  playerId  String
  status    EventPlayerStatus @default(UNKNOWN)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player    Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([eventId, playerId])
  @@index([eventId, status])
  @@index([playerId])
}

model EventSquad {
  id                 String             @id @default(cuid())
  eventId            String
  name               String
  intent             EventSquadIntent
  status             EventSquadStatus    @default(DRAFT)
  targetSize         Int
  minSize            Int?
  maxSize            Int?
  formationId        String?
  generationOrder    Int                @default(0)
  generationSnapshot Json?
  balanceSummary     Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formation          Formation?         @relation(fields: [formationId], references: [id])
  players            EventSquadPlayer[]
  eventMatches       EventMatch[]
  supportSourceAssignments EventMatchSupportAssignment[] @relation("SupportSourceSquad")
  supportTargetAssignments  EventMatchSupportAssignment[] @relation("SupportTargetSquad")

  @@index([eventId])
  @@index([intent])
}

model EventSquadPlayer {
  id                 String                 @id @default(cuid())
  eventSquadId       String
  playerId           String
  assignedRoleType   FormationSlotRoleType?
  assignedPositionId String?
  assignedSlotIndex  Int?
  assignedSlotLabel  String?
  lineupOrder        Int?
  source             EventSquadPlayerSource @default(AUTO)
  locked             Boolean                @default(false)
  selectionReason    Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  positionFitTier    String?
  eventSquad         EventSquad             @relation(fields: [eventSquadId], references: [id], onDelete: Cascade)
  player             Player                 @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([eventSquadId, playerId])
  @@index([playerId])
}

model EventMatch {
  id              String        @id @default(cuid())
  eventId         String
  eventSquadId    String
  category        MatchCategory @default(CUP)
  opponentName    String
  opponentTeamId  String?
  startsAt        DateTime
  location        String?
  notes           String?
  status          MatchStatus   @default(SCHEDULED)
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  event              Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventSquad         EventSquad                @relation(fields: [eventSquadId], references: [id], onDelete: Cascade)
  opponentTeam       OpponentTeam?             @relation(fields: [opponentTeamId], references: [id])
  postMatchReport    EventPostMatchReport?
  supportAssignments EventMatchSupportAssignment[]
  lineup             EventMatchLineup?

  @@index([eventId])
  @@index([eventSquadId])
  @@index([category])
  @@index([startsAt])
  @@index([status])
  @@index([opponentTeamId])
}

model EventPostMatchReport {
  id                String              @id @default(cuid())
  eventMatchId      String              @unique
  status            MatchReportStatus   @default(DRAFT)
  ourScore          Int?
  opponentScore     Int?
  teamReflection    String?
  opponentObservation String?
  notes             String?
  completedBy       String?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  eventMatch        EventMatch           @relation(fields: [eventMatchId], references: [id], onDelete: Cascade)
  playerReports     EventPostMatchPlayer[]
  goalEvents        EventGoalEvent[]
  assistEvents      EventAssistEvent[]

  @@index([status])
}

model EventPostMatchPlayer {
  id               String   @id @default(cuid())
  reportId         String
  playerId         String
  attendanceStatus String   @default("UNKNOWN")
  minutesPlayed    Int?
  role             String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  report           EventPostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  player           Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([reportId, playerId])
  @@index([playerId])
  @@index([attendanceStatus])
}

model EventGoalEvent {
  id        String   @id @default(cuid())
  reportId  String
  playerId  String?
  minute    Int?
  type      String   @default("NORMAL")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report    EventPostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  scorer    Player?              @relation("EventGoalScorer", fields: [playerId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([playerId])
}

model EventAssistEvent {
  id        String   @id @default(cuid())
  reportId  String
  playerId  String
  type      String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report    EventPostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  assist    Player               @relation("EventAssistProvider", fields: [playerId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([playerId])
}

model EventMatchSupportAssignment {
  id                 String   @id @default(cuid())
  eventMatchId       String
  playerId           String
  sourceEventSquadId String
  targetEventSquadId String
  plannedRole        String?
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  eventMatch       EventMatch  @relation(fields: [eventMatchId], references: [id], onDelete: Cascade)
  player           Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  sourceEventSquad EventSquad  @relation("SupportSourceSquad", fields: [sourceEventSquadId], references: [id], onDelete: Restrict)
  targetEventSquad EventSquad  @relation("SupportTargetSquad", fields: [targetEventSquadId], references: [id], onDelete: Cascade)

  @@unique([eventMatchId, playerId])
  @@index([eventMatchId])
  @@index([playerId])
  @@index([sourceEventSquadId])
  @@index([targetEventSquadId])
}

enum EventMatchLineupPlayerSource {
  BASE_SQUAD
  HELPER
}

model EventMatchLineup {
  id            String   @id @default(cuid())
  eventMatchId  String   @unique
  formationId   String?
  status        MatchLineupStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  eventMatch    EventMatch                  @relation(fields: [eventMatchId], references: [id], onDelete: Cascade)
  formation     Formation?                  @relation(fields: [formationId], references: [id], onDelete: SetNull)
  assignments   EventMatchLineupAssignment[]

  @@index([status])
}

model EventMatchLineupAssignment {
  id          String   @id @default(cuid())
  lineupId    String
  playerId    String?
  slotId      String?
  slotIndex   Int?
  slotLabel   String?
  roleType    FormationSlotRoleType?
  source      EventMatchLineupPlayerSource @default(BASE_SQUAD)
  x           Float?
  y           Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineup      EventMatchLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player      Player?          @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([lineupId, playerId])
  @@index([lineupId])
  @@index([playerId])
}

model LeagueSeason {
  id           String            @id @default(cuid())
  name         String
  seasonId     String
  part         LeagueSeasonPart
  startDate    DateTime
  endDate      DateTime
  status       LeagueSeasonStatus @default(OPEN)
  finalizedAt  DateTime?
  finalizedBy  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  matchRounds  MatchRound[]
  season       Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  periodSnapshot SeasonPeriodSnapshot?

  @@index([seasonId])
  @@map("LeagueSeason")
}

enum LeagueSeasonPart {
  SPRING
  FALL
}

enum LeagueSeasonStatus {
  OPEN
  FINALIZED
}

model SeasonPeriodSnapshot {
  id             String   @id @default(cuid())
  leagueSeasonId String   @unique
  leagueSeason   LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  finalizedAt    DateTime
  finalizedBy    String?
  teamSnapshots  TeamSeasonSnapshot[]

  @@index([leagueSeasonId])
  @@map("SeasonPeriodSnapshot")
}

model TeamSeasonSnapshot {
  id                     String   @id @default(cuid())
  seasonPeriodSnapshotId String
  seasonPeriodSnapshot   SeasonPeriodSnapshot @relation(fields: [seasonPeriodSnapshotId], references: [id], onDelete: Cascade)
  teamId                 String
  team                   Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  teamNameSnapshot       String
  playerSnapshots        TeamSeasonSnapshotPlayer[]

  @@index([seasonPeriodSnapshotId])
  @@index([teamId])
  @@map("TeamSeasonSnapshot")
}

model TeamSeasonSnapshotPlayer {
  id                      String   @id @default(cuid())
  teamSeasonSnapshotId    String
  teamSeasonSnapshot      TeamSeasonSnapshot @relation(fields: [teamSeasonSnapshotId], references: [id], onDelete: Cascade)
  playerId                String
  player                  Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerNameSnapshot      String
  primaryPositionSnapshot String?
  secondaryPositionSnapshot String?
  tertiaryPositionSnapshot String?
  shirtNumberSnapshot     Int?
  activeAtSnapshot        Boolean

  @@index([teamSeasonSnapshotId])
  @@index([playerId])
  @@map("TeamSeasonSnapshotPlayer")
}


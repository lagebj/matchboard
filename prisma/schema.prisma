generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id                  String            @id @default(cuid())
  name                String            @unique
  targetSquadSize     Int               @default(11)
  minAcceptedSquadSize Int              @default(9)
  maxSquadSize        Int               @default(14)
  minCorePlayers      Int               @default(8)
  minSupportCount     Int               @default(0)
  targetSupportCount  Int               @default(0)
  maxSupportCount     Int               @default(0)
  maxPlayerChangesPerRound Int          @default(0)
  supportPriority     Int               @default(0)
  minSupportPlayers   Int               @default(0)
  developmentSlots    Int               @default(0)
  archivedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  corePlayers                Player[]                 @relation("CoreTeam")
  matches                    Match[]

  fromRotationPaths RotationPath[] @relation("FromTeam")
  toRotationPaths   RotationPath[] @relation("ToTeam")

  ledgerFromTeam MovementLedger[] @relation("LedgerFromTeam")
  ledgerToTeam   MovementLedger[] @relation("LedgerToTeam")

  @@index([archivedAt, name])
}

model Player {
  id                    String             @id @default(cuid())
  playerCode            Int                @unique
  firstName             String
  lastName              String?
  active                Boolean            @default(true)
  removedAt             DateTime?
  coreTeamId            String?
  nonRotatable          Boolean            @default(false)
  reducedMatchLoadAllowed Boolean          @default(false)
  supportSuitability    String             @default("neutral")
  developmentReadiness  String             @default("neutral")
  primaryPosition       String
  secondaryPosition     String?
  tertiaryPosition      String?
  preferredFoot         FootPreference
  secondaryFoot        SecondaryFoot
  bestSide              BestSide
  currentAvailability   AvailabilityStatus @default(AVAILABLE)
  supportNoShowCount    Int                @default(0)
  ballControl           Int                @default(0)
  passing               Int                @default(0)
  firstTouch            Int                @default(0)
  oneVOneAttacking      Int                @default(0)
  positioning           Int                @default(0)
  oneVOneDefending      Int                @default(0)
  decisionMaking        Int                @default(0)
  effort                Int                @default(0)
  teamplay              Int                @default(0)
  concentration         Int                @default(0)
  speed                 Int                @default(0)
  strength              Int                @default(0)
  notes                 String?
  supportInstruction    String?
  developmentInstruction String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  coreTeam          Team?                 @relation("CoreTeam", fields: [coreTeamId], references: [id], onDelete: Restrict)

  availabilities Availability[]
  selections Selection[]
  ledgerEntries MovementLedger[]
  locks PlayerLock[]
  @@index([coreTeamId, active, removedAt])
  @@index([removedAt, firstName, lastName])
}

model Match {
  id                          String     @id @default(cuid())
  matchRoundId                String
  teamId                      String
  opponent                    String
  startsAt                    DateTime
  homeAway                    MatchVenue
  squadSize                   Int        @default(11)
  availableForDevelopmentSlot Boolean    @default(false)
  matchType                   MatchType  @default(FRIENDLY)
  gameFormat                  GameFormat @default(ELEVEN_A_SIDE)
  formation                  String?
  matchFit                    MatchFit   @default(UNKNOWN)
  notes                       String?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  matchRound MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  selections Selection[]
  movementLedger MovementLedger[]

  @@index([startsAt, createdAt])
}

model RuleConfig {
  id                                 String   @id @default(cuid())
  version                            Int      @default(1)
  name                               String   @default("Default ruleset")
  minDaysBetweenAnyMatches           Int      @default(3)
  warningThreshold                   Int      @default(5)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt
}

model Season {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningPeriods PlanningPeriod[]
}

model PlanningPeriod {
  id        String   @id @default(cuid())
  name      String
  seasonId  String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  matchRounds MatchRound[]
}

model MatchRound {
  id               String   @id @default(cuid())
  name             String
  planningPeriodId String
  status           String   @default("DRAFT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  planningPeriod PlanningPeriod @relation(fields: [planningPeriodId], references: [id], onDelete: Restrict)

  matches Match[]
  availabilities Availability[]
  selections Selection[]
  movementLedger MovementLedger[]
  warnings Warning[]
  playerLocks PlayerLock[]
}

model Availability {
  id           String   @id @default(cuid())
  playerId     String
  matchRoundId String
  status       String
  note         String?
  createdAt    DateTime @default(now())

  player      Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  matchRound  MatchRound  @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
}

model Selection {
  id                    String          @id @default(cuid())
  matchId               String
  matchRoundId          String
  playerId              String
  role                  SelectionRole
  controlledDoubleLoad  Boolean         @default(false)
  status                SelectionStatus @default(DRAFT)
  ruleConfigVersion     Int?
  explanation           Json?
  overrideReason        String?
  overrideReasonCategory OverrideReasonCategory?
  overrideReasonDetail  String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchRound MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId],     references: [id], onDelete: Restrict)
  audits    SelectionAudit[]
}

model RotationPath {
  id                      String @id @default(cuid())
  fromTeamId              String
  toTeamId                String
  role                    SelectionRole
  purpose                 String
  minimumCount            Int?
  targetCount             Int?
  maximumCount            Int?
  cooldownRounds          Int?
  priority                Int?
  active                  Boolean @default(true)
  allowDoubleLoad         Boolean @default(false)
  minRestSpacingHours     Int?
  maxDoubleLoadsPerPeriod Int?

  fromTeam Team @relation("FromTeam", fields: [fromTeamId], references: [id])
  toTeam   Team @relation("ToTeam", fields: [toTeamId], references: [id])
}

model MovementLedger {
  id           String   @id @default(cuid())
  matchRoundId String
  matchId      String
  playerId     String
  fromTeamId   String
  toTeamId     String
  role         SelectionRole
  controlledDoubleLoad Boolean @default(false)
  reason       String?
  explanation  String?
  isDraft      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matchRound MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  fromTeam   Team       @relation("LedgerFromTeam", fields: [fromTeamId], references: [id], onDelete: Restrict)
  toTeam     Team       @relation("LedgerToTeam", fields: [toTeamId], references: [id], onDelete: Restrict)

  @@index([matchRoundId, matchId])
  @@index([playerId])
}

enum FootPreference {
  LEFT
  RIGHT
}

enum SecondaryFoot {
  LEFT
  RIGHT
  WEAK
}

enum BestSide {
  LEFT
  CENTER
  RIGHT
}

enum AvailabilityStatus {
  AVAILABLE
  INJURED
  SICK
  AWAY
  TENTATIVE
  UNKNOWN
}

enum SelectionStatus {
  DRAFT
  FINALIZED
}

enum SelectionRole {
  CORE
  SUPPORT
  BACKFILL
  DEVELOPMENT
  CONFIDENCE_REBUILD
  CORE_MATCH_DROP
  REDUCED_MATCH_LOAD_DROP
  MANUAL_OVERRIDE
}

enum OverrideReasonCategory {
  SQUAD_TOO_SMALL
  SUPPORT_MISSING
  DEVELOPMENT_OPPORTUNITY
  DOUBLE_LOAD_NEEDED
  AVAILABILITY_CHANGED
  COACH_JUDGEMENT
  MATCH_ALREADY_PLAYED
  DATA_CORRECTION
  OTHER
}

enum MatchVenue {
  HOME
  AWAY
}

enum MatchFit {
  UNKNOWN
  TOO_EASY
  GOOD_FIT
  TOO_HARD
  CHAOTIC
  SUPPORT_OVERPOWERED
  SUPPORT_TOO_LOW
}

enum GameFormat {
  SEVEN_A_SIDE
  NINE_A_SIDE
  ELEVEN_A_SIDE
}

enum MatchType {
  LEAGUE
  FRIENDLY
  CUP
  DEVELOPMENT
}

enum WarningSeverity {
  HARD_BLOCK
  REQUIRES_OVERRIDE
  WARNING
  SCORING_PREFERENCE
}

model Warning {
  id           String          @id @default(cuid())
  matchRoundId String
  matchId      String?
  playerId     String?
  teamId       String?
  severity     WarningSeverity
  rule         String
  message      String
  resolved     Boolean         @default(false)
  createdAt    DateTime        @default(now())

  matchRound MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
}

model PlayerLock {
  id           String   @id @default(cuid())
  matchRoundId String
  playerId     String
  lockType     String
  reason       String?
  lockedBy     String?
  createdAt    DateTime @default(now())

  player      Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  matchRound  MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)

  @@unique([matchRoundId, playerId])
}

model SelectionAudit {
  id             String   @id @default(cuid())
  selectionId    String
  changeReason   String
  previousRole   String?
  previousStatus String?
  changedAt      DateTime @default(now())

  selection Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@index([selectionId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AssistantIssue {
  id                    String   @id @default(cuid())
  type                  String
  severity              String
  status                String
  title                 String
  summary               String
  entityType            String
  entityId              String
  affectedTeamIds       Json
  affectedPlayerIds     Json
  ruleIds               Json
  recommendedAction     String
  primaryActionLabel    String
  primaryActionHref     String
  secondaryActionLabel  String?
  secondaryActionHref   String?
  createdAt             DateTime @default(now())
  resolvedAt            DateTime?
  resolutionDecisionId  String?

  @@index([status])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model DecisionRecord {
  id               String   @id @default(cuid())
  decisionType     String
  entityType       String
  entityId         String
  recommendationId String?
  action           String
  reason           String?
  createdBy        String
  createdAt        DateTime @default(now())
  beforeSnapshot   Json?
  afterSnapshot    Json?

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

model SelectionExplanation {
  id              String   @id @default(cuid())
  scopeType       String
  scopeId         String
  matchId         String?
  teamId          String?
  playerId        String?
  summary         String
  rulesApplied    Json
  blockers        Json
  warnings        Json
  recommendations Json
  crossTeamImpacts Json
  createdAt       DateTime @default(now())

  @@index([scopeType, scopeId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@index([createdAt])
}

model PostMatchReport {
  id          String   @id @default(cuid())
  matchId     String   @unique
  status      String
  teamNote    String?
  completedBy String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  playerActuals PostMatchPlayerActual[]

  @@index([status])
}

model PostMatchPlayerActual {
  id               String   @id @default(cuid())
  matchId          String
  playerId         String
  attendanceStatus String
  actualPositions  Json?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reportId         String

  report           PostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([playerId])
  @@index([attendanceStatus])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id                       String           @id @default(cuid())
  name                     String
  organisationId           String?
  targetSquadSize          Int              @default(11)
  minAcceptedSquadSize     Int              @default(9)
  maxSquadSize             Int              @default(14)
  minCorePlayers           Int              @default(8)
  minSupportCount          Int              @default(0)
  targetSupportCount       Int              @default(0)
  maxSupportCount          Int              @default(0)
  maxPlayerChangesPerRound Int              @default(0)
  supportPriority          Int              @default(0)
  minSupportPlayers        Int              @default(0)
  developmentSlots         Int              @default(0)
  archivedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  formations               Formation[]
  matches                  Match[]
  lineups                  MatchLineup[]
  ledgerFromTeam           MovementLedger[] @relation("LedgerFromTeam")
  ledgerToTeam             MovementLedger[] @relation("LedgerToTeam")
  corePlayers              Player[]         @relation("CoreTeam")
  fromRotationPaths        RotationPath[]   @relation("FromTeam")
  toRotationPaths          RotationPath[]   @relation("ToTeam")
  teamSeasonSnapshots     TeamSeasonSnapshot[]
  organisation             Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamAccesses             TeamAccess[]

  @@unique([organisationId, name])
  @@index([archivedAt, name])
  @@index([organisationId])
}

model Player {
  id                      String                    @id @default(cuid())
  organisationId          String?
  playerCode              Int                       @unique
  shirtNumber             Int?
  firstName               String
  lastName                String?
  active                  Boolean                   @default(true)
  removedAt               DateTime?
  coreTeamId              String?
  nonRotatable            Boolean                   @default(false)
  reducedMatchLoadAllowed Boolean                   @default(false)
  supportSuitability      String                    @default("neutral")
  developmentReadiness    String                    @default("neutral")
  primaryPosition         String
  secondaryPosition       String?
  tertiaryPosition        String?
  preferredFoot           FootPreference
  secondaryFoot           SecondaryFoot
  bestSide                BestSide
  currentAvailability     AvailabilityStatus        @default(AVAILABLE)
  supportNoShowCount      Int                       @default(0)
  ballControl             Int?
  passing                 Int?
  firstTouch              Int?
  oneVOneAttacking        Int?
  positioning             Int?
  oneVOneDefending        Int?
  decisionMaking          Int?
  effort                  Int?
  teamplay                Int?
  concentration           Int?
  speed                   Int?
  strength                Int?
  notes                   String?
  supportInstruction      String?
  developmentInstruction  String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  goalkeeperAbility       GoalkeeperAbility         @default(NO)
  lastRatedAt             DateTime?
  assists                 Assist[]
  availabilities          Availability[]
  eventAvailability       EventPlayerAvailability[]
  eventSquadPlayers       EventSquadPlayer[]
  goals                   Goal[]
  executionFeedback       MatchExecutionFeedback[]
  matchReportAbsences     MatchReportAbsence[]
  matchReportStats        MatchReportPlayerStat[]
  movementCandidates      MovementCandidate[]
  ledgerEntries           MovementLedger[]
  organisation             Organisation?             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  coreTeam                 Team?                     @relation("CoreTeam", fields: [coreTeamId], references: [id], onDelete: Restrict)
  locks                   PlayerLock[]
  positions               PlayerPosition[]
  readinessSignals        PlayerReadinessSignal[]
  developmentObservations PlayerDevelopmentObservation[]
  profileSuggestions      PlayerProfileSuggestion[]
  postMatchActuals        PostMatchPlayerActual[]
  selections              Selection[]
  eventPostMatchPlayers   EventPostMatchPlayer[]
  eventGoalEvents        EventGoalEvent[]        @relation("EventGoalScorer")
  eventAssistEvents      EventAssistEvent[]       @relation("EventAssistProvider")
  eventSupportAssignments EventMatchSupportAssignment[]
  eventLineupAssignments EventMatchLineupAssignment[]
  playerSeasonSnapshots TeamSeasonSnapshotPlayer[]
  liveEventsScorer        LiveMatchEvent[]             @relation("LiveEventScorer")
  liveEventsSecondary     LiveMatchEvent[]             @relation("LiveEventSecondaryPlayer")
  rotationsOut            MatchRotation[]              @relation("RotationOutPlayer")
  rotationsIn             MatchRotation[]              @relation("RotationInPlayer")
  fairPlayObservations    FairPlayObservation[]

  @@index([coreTeamId, active, removedAt])
  @@index([removedAt, firstName, lastName])
  @@index([organisationId])
  @@unique([organisationId, playerCode])
}

model Match {
  id                          String                        @id @default(cuid())
  organisationId              String?
  matchRoundId                String
  teamId                      String
  opponent                    String
  startsAt                    DateTime
  homeAway                    MatchVenue
  squadSize                   Int                           @default(11)
  availableForDevelopmentSlot Boolean                       @default(false)
  matchType                   MatchType                     @default(FRIENDLY)
  gameFormat                  GameFormat                    @default(ELEVEN_A_SIDE)
  formation                   String?
  matchFit                    MatchFit                      @default(UNKNOWN)
  notes                       String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  opponentTeamId              String?
  status                      MatchStatus                   @default(SCHEDULED)
  cancelledAt                 DateTime?
  cancelledReason             String?
  category                    MatchCategory                 @default(LEAGUE)
  matchRound                  MatchRound                    @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  opponentTeam                OpponentTeam?                 @relation(fields: [opponentTeamId], references: [id])
  team                        Team                          @relation(fields: [teamId], references: [id])
  organisation                Organisation?                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  executionFeedback           MatchExecutionFeedback[]
  lineups                     MatchLineup[]
  liveSession                 LiveMatchSession?
  liveEvents                  LiveMatchEvent[]
  rotations                  MatchRotation[]
  fairPlayObservations        FairPlayObservation[]
  movementLedger              MovementLedger[]
  opponentObservation         OpponentEncounterObservation?
  sportingEvidence            OpponentSportingEvidence?
  developmentObservations     PlayerDevelopmentObservation[]
  selections                  Selection[]
  teamReflection              TeamReflection?

  @@index([startsAt, createdAt])
  @@index([opponentTeamId])
  @@index([category])
  @@index([organisationId])
}

model OpponentTeam {
  id             String                         @id @default(cuid())
  organisationId String?
  displayName    String
  normalizedName String                         @unique
  archivedAt     DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  matches        Match[]
  eventMatches   EventMatch[]
  observations   OpponentEncounterObservation[]
  sportingEvidence OpponentSportingEvidence[]
  organisation   Organisation?                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([archivedAt, displayName])
  @@index([organisationId])
  @@unique([organisationId, normalizedName])
}

model RuleConfig {
  id                       String   @id @default(cuid())
  organisationId          String?
  version                  Int      @default(1)
  name                     String   @default("Default ruleset")
  minDaysBetweenAnyMatches Int      @default(3)
  warningThreshold         Int      @default(5)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  organisation             Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model Season {
  id            String         @id @default(cuid())
  organisationId String?
  name          String
  year          Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leagueSeasons LeagueSeason[]
  organisation  Organisation?  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("Season")
}

model MatchRound {
  id              String           @id @default(cuid())
  organisationId  String?
  name            String
  leagueSeasonId  String
  status          String           @default("DRAFT")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  availabilities  Availability[]
  matches         Match[]
  leagueSeason    LeagueSeason     @relation(fields: [leagueSeasonId], references: [id])
  organisation    Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  movementLedger   MovementLedger[]
  playerLocks      PlayerLock[]
  selections       Selection[]
  warnings         Warning[]

  @@index([leagueSeasonId])
  @@index([organisationId])
  @@map("MatchRound")
}

model Availability {
  id           String           @id @default(cuid())
  organisationId String?
  playerId     String
  matchRoundId String
  status       AvailabilityStatus @default(AVAILABLE)
  note         String?
  createdAt    DateTime         @default(now())
  matchRound   MatchRound       @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player       Player           @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchRoundId])
  @@index([organisationId])
}

model Selection {
  id                     String                      @id @default(cuid())
  organisationId         String?
  matchId                String
  matchRoundId           String
  playerId               String
  role                   SelectionRole
  controlledDoubleLoad   Boolean                     @default(false)
  status                 SelectionStatus             @default(DRAFT)
  ruleConfigVersion      Int?
  explanation            Json?
  manuallyAdded          Boolean                     @default(false)
  manuallyRemoved        Boolean                     @default(false)
  autoSelected           Boolean                     @default(true)
  sourceTeamName         String?
  targetTeamName         String?
  selectionReason        String?
  overrideReason         String?
  overrideReasonCategory OverrideReasonCategory?
  overrideReasonDetail   String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  matchdayResponsibility MatchdayResponsibilityType?
  match                  Match                       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchRound             MatchRound                  @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player                 Player                      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation           Organisation?               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  audits                 SelectionAudit[]

  @@index([matchRoundId, status])
  @@index([matchId, status])
  @@index([playerId, matchRoundId])
  @@index([playerId])
  @@index([organisationId])
}

model RotationPath {
  id                      String              @id @default(cuid())
  organisationId          String?
  fromTeamId              String
  toTeamId                String
  role                    SelectionRole
  purpose                 String
  minimumCount            Int?
  targetCount             Int?
  maximumCount            Int?
  cooldownRounds          Int?
  priority                Int?
  active                  Boolean             @default(true)
  allowDoubleLoad         Boolean             @default(false)
  minRestSpacingHours     Int?
  maxDoubleLoadsPerPeriod Int?
  movementCandidates      MovementCandidate[]
  fromTeam                Team                @relation("FromTeam", fields: [fromTeamId], references: [id])
  toTeam                  Team                @relation("ToTeam", fields: [toTeamId], references: [id])
  organisation            Organisation?       @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([fromTeamId, toTeamId, role])
  @@index([organisationId])
}

model MovementLedger {
  id                   String        @id @default(cuid())
  organisationId        String?
  matchRoundId         String
  matchId              String
  playerId             String
  fromTeamId           String
  toTeamId             String
  role                 SelectionRole
  controlledDoubleLoad Boolean       @default(false)
  reason               String?
  explanation          String?
  isDraft              Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  fromTeam             Team          @relation("LedgerFromTeam", fields: [fromTeamId], references: [id])
  match                Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchRound           MatchRound    @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player               Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  toTeam               Team          @relation("LedgerToTeam", fields: [toTeamId], references: [id])
  organisation         Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([matchRoundId, matchId])
  @@index([playerId])
  @@index([organisationId])
}

model Formation {
  id              String          @id @default(cuid())
  organisationId  String?
  name            String
  gameFormat      GameFormat
  source          FormationSource @default(SYSTEM)
  teamId          String?
  createdByUserId String?
  description     String?
  isArchived      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  eventSquads     EventSquad[]
  team            Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slots           FormationSlot[]
  lineups         MatchLineup[]
  eventLineups    EventMatchLineup[]
  organisation    Organisation?   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([gameFormat])
  @@index([teamId])
  @@index([source, isArchived])
  @@index([organisationId])
}

model FormationSlot {
  id                  String                @id @default(cuid())
  organisationId      String?
  formationId         String
  gridX               Int
  gridY               Int
  label               String
  shortLabel          String
  roleType            FormationSlotRoleType
  acceptedPositionIds Json                  @default("[]")
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  formation           Formation             @relation(fields: [formationId], references: [id], onDelete: Cascade)
  organisation        Organisation?          @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([formationId, gridX, gridY])
  @@index([formationId])
  @@index([formationId, sortOrder])
  @@index([organisationId])
}

model MatchLineup {
  id                String                  @id @default(cuid())
  organisationId    String?
  matchId           String
  teamId            String
  formationId       String?
  status            MatchLineupStatus       @default(DRAFT)
  formationSnapshot Json?
  benchPlayerIds    Json                    @default("[]")
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  formation         Formation?              @relation(fields: [formationId], references: [id])
  match             Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team              Team                    @relation(fields: [teamId], references: [id])
  organisation      Organisation?           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignments       MatchLineupAssignment[]

  @@index([matchId])
  @@index([teamId])
  @@index([status])
  @@index([organisationId])
}

model MatchLineupAssignment {
  id            String                      @id @default(cuid())
  organisationId String?
  matchLineupId String
  slotId        String
  playerId      String?
  locked        Boolean                     @default(false)
  source        MatchLineupAssignmentSource @default(MANUAL)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  matchLineup   MatchLineup                 @relation(fields: [matchLineupId], references: [id], onDelete: Cascade)
  organisation Organisation?               @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([matchLineupId, slotId])
  @@unique([matchLineupId, playerId])
  @@index([matchLineupId])
  @@index([playerId])
  @@index([organisationId])
}

model PlayerPosition {
  id         String                 @id @default(cuid())
  organisationId String?
  playerId   String
  positionId String
  priority   PlayerPositionPriority @default(PRIMARY)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  player     Player                 @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([playerId, positionId])
  @@index([playerId])
  @@index([positionId])
  @@index([organisationId])
}

model Warning {
  id           String          @id @default(cuid())
  organisationId String?
  matchRoundId String
  matchId      String?
  playerId     String?
  teamId       String?
  severity     WarningSeverity
  rule         String
  message      String
  resolved     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  matchRound   MatchRound      @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  organisation Organisation?  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model PlayerLock {
  id              String     @id @default(cuid())
  organisationId  String?
  matchRoundId    String
  playerId        String
  lockType        String
  reason          String?
  lockedBy        String?
  createdAt       DateTime   @default(now())
  matchRound      MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player          Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([matchRoundId, playerId])
  @@index([organisationId])
}

model SelectionAudit {
  id             String    @id @default(cuid())
  organisationId String?
  selectionId    String
  changeReason   String
  previousRole   String?
  previousStatus String?
  changedAt      DateTime  @default(now())
  selection      Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([selectionId])
  @@index([organisationId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   OrganisationMembership[]
  sentInvitations OrganisationInvitation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DecisionRecord {
  id               String   @id @default(cuid())
  organisationId   String?
  decisionType     String
  entityType       String
  entityId         String
  recommendationId String?
  action           String
  reason           String?
  createdBy        String
  createdAt        DateTime @default(now())
  beforeSnapshot   Json?
  afterSnapshot    Json?
  organisation     Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@index([organisationId])
}

model CoachingIntent {
  id        String                  @id @default(cuid())
  organisationId String?
  scopeType CoachingIntentScopeType
  scopeId   String
  category  CoachingIntentCategory
  note      String?
  createdBy String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  organisation Organisation?         @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([scopeType, scopeId])
  @@index([category])
  @@index([organisationId])
}

model PostMatchReport {
  id            String                  @id @default(cuid())
  organisationId String?
  matchId       String                  @unique
  teamNote      String?
  completedBy   String?
  completedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  awayGoals     Int?
  homeGoals     Int?
  status        MatchReportStatus       @default(DRAFT)
  assists       Assist[]
  goals         Goal[]
  absences      MatchReportAbsence[]
  playerStats   MatchReportPlayerStat[]
  playerActuals PostMatchPlayerActual[]
  organisation Organisation?           @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([organisationId])
}

model PostMatchPlayerActual {
  id                        String                     @id @default(cuid())
  organisationId            String?
  matchId                   String
  playerId                  String
  attendanceStatus          String                     @default("UNKNOWN")
  actualPositions           Json?
  note                      String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  reportId                  String
  source                    String                     @default("PLANNED")
  unplannedAppearanceReason UnplannedAppearanceReason?
  player                    Player                     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  report                    PostMatchReport            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organisation              Organisation?              @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([playerId])
  @@index([attendanceStatus])
  @@index([organisationId])
}

model Goal {
  id               String   @id @default(cuid())
  organisationId   String?
  reportId         String
  playerId  String?
  minute    Int?
  type      String          @default("NORMAL")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  player    Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  report    PostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([playerId])
  @@index([organisationId])
}

model Assist {
  id             String          @id @default(cuid())
  organisationId String?
  reportId       String
  playerId       String
  type           String          @default("NORMAL")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  player         Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)
  report         PostMatchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organisation   Organisation?   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([playerId])
  @@index([organisationId])
}

model MatchReportAbsence {
  id            String               @id @default(cuid())
  organisationId String?
  matchReportId String
  matchId       String
  playerId      String
  reason        PlannedAbsenceReason
  note          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  report        PostMatchReport      @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
  player        Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation  Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([matchReportId, playerId])
  @@index([matchId])
  @@index([playerId])
  @@index([organisationId])
}

model MatchReportPlayerStat {
  id             String          @id @default(cuid())
  organisationId String?
  matchReportId  String
  playerId       String
  goals          Int             @default(0)
  assists        Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  report         PostMatchReport @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
  player         Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation   Organisation?   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([matchReportId, playerId])
  @@index([playerId])
  @@index([organisationId])
}

model PlayerReadinessSignal {
  id         String               @id @default(cuid())
  organisationId String?
  playerId   String
  signalType ReadinessSignalType
  value      ReadinessSignalValue
  note       String?
  recordedBy String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  player     Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation Organisation?      @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([playerId, signalType])
  @@index([playerId])
  @@index([signalType])
  @@index([organisationId])
}

model MatchExecutionFeedback {
  id                 String             @id @default(cuid())
  organisationId     String?
  matchId            String
  playerId           String
  category           FeedbackCategory
  value              String
  observableBehavior String?
  nextAction         FeedbackNextAction @default(NO_ACTION)
  note               String?
  recordedBy         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  match              Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player             Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation       Organisation?      @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId, category])
  @@index([matchId])
  @@index([playerId])
  @@index([category])
  @@index([organisationId])
}

model LiveMatchSession {
  id              String            @id @default(cuid())
  organisationId  String?
  matchId         String            @unique
  coachId         String
  status          LiveSessionStatus @default(ACTIVE)
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  lastHeartbeatAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt


model Organisation {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  isSynthetic     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships                     OrganisationMembership[]
  invitations                      OrganisationInvitation[]
  teams                            Team[]
  machinePrincipals                MachinePrincipal[]
  players                          Player[]
  opponentTeams                    OpponentTeam[]
  leagueSeasons                   LeagueSeason[]
  seasons                         Season[]
  matches                         Match[]
  matchRounds                     MatchRound[]
  availabilities                  Availability[]
  selections                      Selection[]
  rotationPaths                   RotationPath[]
  movementLedgers                 MovementLedger[]
  formations                      Formation[]
  formationSlots                  FormationSlot[]
  matchLineups                    MatchLineup[]
  matchLineupAssignments          MatchLineupAssignment[]
  playerPositions                 PlayerPosition[]
  warnings                        Warning[]
  playerLocks                     PlayerLock[]
  selectionAudits                 SelectionAudit[]
  decisionRecords                 DecisionRecord[]
  coachingIntents                 CoachingIntent[]
  postMatchReports                PostMatchReport[]
  postMatchPlayerActuals          PostMatchPlayerActual[]
  goals                           Goal[]
  assists                         Assist[]
  matchReportAbsences             MatchReportAbsence[]
  matchReportPlayerStats          MatchReportPlayerStat[]
  playerReadinessSignals          PlayerReadinessSignal[]
  matchExecutionFeedbacks         MatchExecutionFeedback[]
  liveMatchSessions                LiveMatchSession[]
  liveMatchEvents                  LiveMatchEvent[]
  matchRotations                   MatchRotation[]
  fairPlayObservations             FairPlayObservation[]
  teamReflections                 TeamReflection[]
  opponentEncounterObservations   OpponentEncounterObservation[]
  selectionExplanations           SelectionExplanation[]
  movementCandidates              MovementCandidate[]
  events                          Event[]
  eventPlayerAvailabilities       EventPlayerAvailability[]
  eventSquads                     EventSquad[]
  eventSquadPlayers               EventSquadPlayer[]
  eventMatches                    EventMatch[]
  eventPostMatchReports           EventPostMatchReport[]
  eventPostMatchPlayers           EventPostMatchPlayer[]
  eventGoalEvents                 EventGoalEvent[]
  eventAssistEvents               EventAssistEvent[]
  eventMatchSupportAssignments    EventMatchSupportAssignment[]
  eventMatchLineups               EventMatchLineup[]
  eventMatchLineupAssignments     EventMatchLineupAssignment[]
  seasonPeriodSnapshots           SeasonPeriodSnapshot[]
  teamSeasonSnapshots             TeamSeasonSnapshot[]
  teamSeasonSnapshotPlayers       TeamSeasonSnapshotPlayer[]
  policyDecisionLogs              PolicyDecisionLog[]
  opponentSportingEvidence        OpponentSportingEvidence[]
  developmentObservations         PlayerDevelopmentObservation[]
  profileSuggestions              PlayerProfileSuggestion[]
  ruleConfigs                     RuleConfig[]
  reviewRequests                  ReviewRequest[]

  @@index([slug])
  @@index([name])
}

model OrganisationMembership {
  id             String          @id @default(cuid())
  userId         String
  organisationId String
  role           OrganisationRole @default(COACH)
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamAccesses  TeamAccess[]

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@index([userId])
  @@index([role])
  @@index([expiresAt])
}

model OrganisationInvitation {
  id                String          @id @default(cuid())
  organisationId    String
  invitedEmail      String
  intendedRole      OrganisationRole @default(COACH)
  token             String          @unique
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  status            InvitationStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  invitedByUserId   String
  invitedBy         User            @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
  organisation      Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, invitedEmail, status])
  @@index([token])
  @@index([organisationId])
  @@index([invitedEmail])
  @@index([expiresAt])
}

model TeamAccess {
  id               String   @id @default(cuid())
  membershipId     String
  teamId           String
  createdAt        DateTime @default(now())

  membership       OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  team             Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([membershipId, teamId])
  @@index([teamId])
  @@index([membershipId])
}

model MachinePrincipal {
  id               String                  @id @default(cuid())
  organisationId   String
  name             String
  description      String?
  status           MachinePrincipalStatus   @default(ACTIVE)
  clientCredentialHash String?
  clientCredentialPrefix String?
  scopes           String[]
  lastUsedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organisation     Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([status])
  @@index([clientCredentialPrefix])
}

model PolicyDecisionLog {
  id                  String   @id @default(cuid())
  organisationId      String?
  decisionType        String
  policyRuntime       String?  @default("default")
  policyVersionHash   String?
  policyPackId        String?
  inputHash           String?
  resultSummaryJson   String?
  relatedEventId      String?
  relatedEventMatchId String?
  relatedLeagueMatchId String?
  relatedTeamId       String?
  blockedCount        Int      @default(0)
  warningCount        Int      @default(0)
  scoreAdjustmentCount Int     @default(0)
  explanationCount    Int      @default(0)
  regoEnabled         Boolean  @default(false)
  regoFailureMode     String?  @default("fail_closed")
  createdAt           DateTime @default(now())
  organisation        Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([decisionType])
  @@index([relatedEventId])
  @@index([relatedLeagueMatchId])
  @@index([createdAt])
  @@index([organisationId])
}

model OpponentSportingEvidence {
  id                        String                        @id @default(cuid())
  organisationId            String?
  matchId                   String                        @unique
  opponentTeamId            String
  occurredAt                DateTime
  gameFormat                GameFormat?
  goalsFor                  Int
  goalsAgainst              Int
  fieldedRatingSnapshot     Decimal?                      @db.Decimal(4, 2)
  participantCount          Int
  ratedParticipantCount     Int
  weightingMethod           OpponentWeightingMethod        @default(PARTICIPANT_AVERAGE)
  estimate                  Decimal                       @db.Decimal(4, 2)
  formulaVersion            String
  excludedAt                DateTime?
  exclusionReason           String?
  fieldedRatingDetails      Json?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  match                     Match                         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  opponentTeam              OpponentTeam                   @relation(fields: [opponentTeamId], references: [id])
  organisation              Organisation?                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([opponentTeamId, occurredAt])
  @@index([opponentTeamId, gameFormat, occurredAt])
  @@index([organisationId])
  @@index([excludedAt])
}

model PlayerDevelopmentObservation {
  id                String                      @id @default(cuid())
  organisationId    String?
  playerId          String
  sourceType        DevelopmentObservationSource @default(LEAGUE_MATCH)
  matchId           String
  kind               DevelopmentObservationKind
  attributeKey       String?
  positionId         String?
  direction          DevelopmentDirection
  observableNote    String?
  observedAt        DateTime
  recordedBy        String
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  player            Player                      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  match              Match                       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  organisation       Organisation?               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  suggestionEvidence PlayerProfileSuggestionEvidence[]

  @@index([playerId, attributeKey, observedAt])
  @@index([playerId, positionId, observedAt])
  @@index([matchId])
  @@index([organisationId])
  @@index([recordedBy])
}

model PlayerProfileSuggestion {
  id                 String                        @id @default(cuid())
  organisationId     String?
  playerId           String
  targetType         DevelopmentObservationKind
  attributeKey       String?
  positionId         String?
  confidence         SuggestionConfidence
  direction          DevelopmentDirection
  currentSnapshot    Json
  proposedSnapshot   Json
  evidenceSummary    Json
  status             SuggestionStatus              @default(PENDING)
  decidedAt          DateTime?
  decidedBy          String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  player             Player                        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisation       Organisation?                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  evidenceLinks      PlayerProfileSuggestionEvidence[]

  @@unique([playerId, targetType, attributeKey, positionId, status])
  @@index([playerId, status])
  @@index([playerId, targetType])
  @@index([organisationId])
  @@index([status])
  @@index([decidedAt])
}

model PlayerProfileSuggestionEvidence {
  id             String                     @id @default(cuid())
  suggestionId   String
  observationId  String
  createdAt      DateTime                   @default(now())
  suggestion     PlayerProfileSuggestion    @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  observation    PlayerDevelopmentObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, observationId])
  @@index([suggestionId])
  @@index([observationId])
}

enum OpponentWeightingMethod {
  MINUTE_WEIGHTED
  PARTICIPANT_AVERAGE
}

enum DevelopmentObservationSource {
  LEAGUE_MATCH
  EVENT_MATCH
}

enum DevelopmentObservationKind {
  ATTRIBUTE
  POSITION
}

enum DevelopmentDirection {
  POSITIVE
  NEGATIVE
}

enum SuggestionConfidence {
  MEDIUM
  HIGH
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  ADJUSTED
  REJECTED
  SUPERSEDED
}

// ─── Transactional email outbox ──────────────────────────────────────────────

enum NotificationTemplate {
  ORGANISATION_INVITATION
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  FAILED
}

model NotificationOutbox {
  id              String              @id @default(cuid())
  organisationId  String?
  idempotencyKey  String?             @unique
  template        NotificationTemplate
  payload         Json
  status          NotificationStatus  @default(PENDING)
  scheduledAt     DateTime            @default(now())
  processedAt     DateTime?
  retryCount      Int                 @default(0)
  maxRetries      Int                 @default(5)
  nextRetryAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  deliveries      NotificationDelivery[]
  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@index([organisationId])
  @@index([template])
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  outboxId           String
  recipientEmail     String
  recipientUserId    String?
  providerMessageId  String?
  status             DeliveryStatus     @default(QUEUED)
  statusDetail       String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  bouncedAt          DateTime?
  bouncedReason      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  outbox             NotificationOutbox  @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId])
  @@index([recipientEmail])
  @@index([recipientUserId])
  @@index([status])
  @@index([providerMessageId])
}

model ProviderWebhookEvent {
  id                String   @id @default(cuid())
  provider          String   @default("brevo")
  eventId           String   @unique
  eventType         String
  providerMessageId String?
  recipientEmail    String?
  payload           Json
  processed         Boolean  @default(false)
  processedAt       DateTime?
  receivedAt        DateTime @default(now())

  @@index([provider, eventType])
  @@index([providerMessageId])
  @@index([processed, receivedAt])
  @@index([eventId])
}

enum ReviewTargetType {
  EVENT_SQUAD
  MATCH_LINEUP
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CANCELLED
  SUPERSEDED
}

model ReviewRequest {
  id                      String          @id @default(cuid())
  organisationId          String?
  targetType              ReviewTargetType
  targetId                String
  targetRevision          String
  requestedByMembershipId String
  reviewerMembershipId    String
  status                  ReviewStatus    @default(PENDING)
  requestMessage          String?
  reviewerComment         String?
  resolvedAt              DateTime?
  supersededById          String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@index([targetType, targetId, status])
  @@index([reviewerMembershipId, status])
  @@index([requestedByMembershipId])
  @@index([organisationId])
}

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and local secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.*.backup
!.env.example
*.crt
*.key
*.pem

# Generated code
/src/generated/prisma
*.tsbuildinfo
next-env.d.ts

# Next.js
/.next/
/out/
/build

# Coverage
/coverage

# Data directories (never commit real data)
/data/
/exports/
/imports/
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
tmp/

# Logs and OS
.DS_Store
Thumbs.db
npm-debug.log*

# Tooling
.vercel
.idea/
.vscode/
.codex

# Claude Code session and personal memory (auto-managed, not committed)
.claude/settings.local.json
.claude/todos/

# Claude Code managed skill symlinks (created by sync-agent-skills.sh)
# The .claude/skills/ directory contains symlinks to the canonical skill
# repositories and must not be committed — it is rebuilt on container creation.
# Keep the committed CLAUDE.md and any committed .claude/ content.
.claude/skills/

# OPA binary cache
.opa-cache/
.devcontainer/devcontainer-lock.json

# Operational tooling state (never commit credentials or local auth)
.neon/
.vercel/
.brevo/

pnpm-workspace.yaml
.matchboard-work/

# Local package store
.pnpm-store/

# Local task plans
tasks/

# Security tool generated results (never commit scanner output)
.security/results/
.security/tmp/

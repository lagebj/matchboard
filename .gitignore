# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and local secrets
.env
workers/**/.dev.vars

# Cloudflare Workers local dev/build state
.wrangler/
workers/**/.wrangler/
workers/**/node_modules/
.env.local
.env.*.local
.env.production
.env.staging
.env.*.backup
!.env.example
*.crt
*.key
*.pem

# Generated code
/src/generated/prisma
*.tsbuildinfo
next-env.d.ts

# Next.js
/.next/
/out/
/build

# Coverage
/coverage

# Playwright (e2e)
/playwright-report/
/test-results/
/blob-report/
/e2e/.auth/

# Data directories (never commit real data)
/data/
/exports/
/imports/
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
tmp/

# Logs and OS
.DS_Store
Thumbs.db
npm-debug.log*

# Tooling
.vercel
.idea/
.vscode/
.codex

# Claude Code session and personal memory (auto-managed, not committed)
.claude/settings.local.json
.claude/todos/

# Claude Code managed skill symlinks (created by sync-agent-skills.sh)
# The .claude/skills/ directory contains symlinks to the canonical skill
# repositories and must not be committed — it is rebuilt on container creation.
# Keep the committed CLAUDE.md and any committed .claude/ content.
.claude/skills/

# OPA binary cache
.opa-cache/
.devcontainer/devcontainer-lock.json

# Operational tooling state (never commit credentials or local auth)
.neon/
.vercel/
.brevo/

.matchboard-work/

# pnpm is not the project's package manager (ARR-0023: Vercel's Install Command now explicitly
# forces `npm ci`, independent of lockfile presence). Do not commit these even if a local `pnpm
# install` regenerates them -- npm/package-lock.json is the single dependency source of truth.
pnpm-lock.yaml
pnpm-workspace.yaml

# Local package store
.pnpm-store/

# Local task plans
tasks/

# Security tool generated results (never commit scanner output)
.security/results/
.security/tmp/

# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

{
  "name": "matchboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "cp -n .env.example .env 2>/dev/null; prisma generate && prisma migrate deploy",
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma.config.ts next.config.ts eslint.config.mjs prisma/seed-demo.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "cp -n .env.example .env 2>/dev/null; prisma generate && prisma migrate dev && node prisma/seed-demo.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:demo": "node prisma/seed-demo.cjs",
    "seed:demo": "node prisma/seed-demo.cjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/client": "^7.8.0",
    "@react-aria/datepicker": "^3.17.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}

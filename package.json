{
  "name": "matchboard",
  "version": "0.14.2",
  "private": true,
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "cp -n .env.example .env 2>/dev/null; prisma generate",
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma.config.ts next.config.ts eslint.config.mjs prisma/seed-demo.cjs playwright.config.ts e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.config.components.ts",
    "test:watch": "vitest",
    "test:components": "vitest run --config vitest.config.components.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup": "cp -n .env.example .env 2>/dev/null; prisma generate && prisma migrate dev && node prisma/seed-demo.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:demo": "node prisma/seed-demo.cjs",
    "db:seed:test": "MATCHBOARD_ENV=test npx tsx scripts/seed-test-dataset.ts",
    "db:export": "npx tsx scripts/export-full-app-state.ts",
    "db:import": "npx tsx scripts/import-full-app-state.ts",
    "seed:demo": "node prisma/seed-demo.cjs",
    "seed:test": "MATCHBOARD_ENV=test npx tsx scripts/seed-test-dataset.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "policy:test": "node scripts/policy-test-deployable.mjs",
    "policy:test:examples": "node scripts/policy-test-examples.mjs",
    "policy:build": "node scripts/build-opa-policy.mjs",
    "policy:build:pack": "node scripts/build-opa-policy.mjs --pack matchboard-default",
    "policy:sync": "node scripts/policy-sync.mjs",
    "policy:verify": "node scripts/policy-verify.mjs",
    "policy:validate": "node scripts/policy-validate.mjs",
    "policy:validate:pack": "node scripts/policy-validate.mjs --pack matchboard-default",
    "policy:list": "node scripts/policy-list.mjs",
    "policy:dry-run": "node scripts/policy-dry-run.mjs",
    "policy:dry-run:pack": "node scripts/policy-dry-run.mjs --pack matchboard-default",
    "workbench:dry-run": "node scripts/workbench-dry-run.mjs",
    "version:patch": "node scripts/version-bump.mjs patch",
    "version:minor": "node scripts/version-bump.mjs minor",
    "version:verify": "node scripts/verify-version.mjs",
    "version:sync": "node scripts/sync-version-module.mjs",
    "prebuild": "node scripts/sync-version-module.mjs",
    "terminology:check": "node scripts/check-terminology.mjs",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs",
    "security:check-sql": "npx tsx scripts/check-forbidden-sql.ts",
    "security:check-supply-chain": "npx tsx scripts/check-supply-chain.ts",
    "security:tools": "bash scripts/security-tools-verify.sh",
    "security:semgrep": "semgrep scan --config auto --config security/semgrep/matchboard-rules.yml --json -o .security/results/semgrep.json --force --no-git-ignore src/ && semgrep scan --config auto --config security/semgrep/matchboard-rules.yml --force --no-git-ignore src/ || true",
    "security:deps": "osv-scanner scan --lockfile=package-lock.json --config=security/osv-scanner.toml --format json --output .security/results/osv.json . || osv-scanner scan --lockfile=package-lock.json --config=security/osv-scanner.toml . || true",
    "security:secrets": "gitleaks detect --source . --config security/gitleaks.toml --report-format json --report-path .security/results/gitleaks.json --no-git --verbose || true",
    "security:secrets:history": "gitleaks detect --source . --config security/gitleaks.toml --report-format json --report-path .security/results/gitleaks-history.json --verbose || true",
    "security:authz": "TEST_DATABASE_URL=$TEST_DATABASE_URL npx vitest run src/test/security-authz.test.ts",
    "security:static": "npm run security:check-sql && npm run security:check-supply-chain && npm run security:semgrep && npm run security:deps && npm run security:secrets",
    "security:dast:baseline": "bash scripts/zap-baseline.sh",
    "security:dast:active": "bash scripts/zap-active.sh",
    "security:review": "bash scripts/security-review.sh",
    "docs:check": "node scripts/check-docs.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run policy:verify && npm run version:verify && npm run terminology:check && npm run architecture:check && npm run security:check-sql && npm run security:check-supply-chain && npm run docs:check"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@getbrevo/brevo": "^6.0.2",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}

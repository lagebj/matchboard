{
  "name": "matchboard",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "cp -n .env.example .env 2>/dev/null; prisma generate",
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma.config.ts next.config.ts eslint.config.mjs prisma/seed-demo.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.config.components.ts",
    "test:watch": "vitest",
    "test:components": "vitest run --config vitest.config.components.ts",
    "setup": "cp -n .env.example .env 2>/dev/null; prisma generate && prisma migrate dev && node prisma/seed-demo.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:demo": "node prisma/seed-demo.cjs",
    "db:export": "npx tsx scripts/export-full-app-state.ts",
    "db:import": "npx tsx scripts/import-full-app-state.ts",
    "db:migrate-sqlite": "SQLITE_DATABASE_URL=\"file:./prisma/matchboard.local.db\" npx tsx scripts/migrate-sqlite-to-postgres.ts",
    "seed:demo": "node prisma/seed-demo.cjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "policy:test": "node scripts/policy-test-deployable.mjs",
    "policy:test:examples": "node scripts/policy-test-examples.mjs",
    "policy:build": "node scripts/build-opa-policy.mjs",
    "policy:build:pack": "node scripts/build-opa-policy.mjs --pack matchboard-default",
    "policy:sync": "node scripts/policy-sync.mjs",
    "policy:verify": "node scripts/policy-verify.mjs",
    "policy:validate": "node scripts/policy-validate.mjs",
    "policy:validate:pack": "node scripts/policy-validate.mjs --pack matchboard-default",
    "policy:list": "node scripts/policy-list.mjs",
    "policy:dry-run": "node scripts/policy-dry-run.mjs",
    "policy:dry-run:pack": "node scripts/policy-dry-run.mjs --pack matchboard-default",
    "workbench:dry-run": "node scripts/workbench-dry-run.mjs",
    "version:sync": "node scripts/version-sync.mjs && node scripts/sync-version-module.mjs",
    "version:verify": "node scripts/verify-version.mjs",
    "version:dry-run": "node scripts/version-sync.mjs --dry-run",
    "prebuild": "node scripts/sync-version-module.mjs",
    "terminology:check": "node scripts/check-terminology.mjs",
    "security:check-sql": "npx tsx scripts/check-forbidden-sql.ts",
    "security:check-supply-chain": "npx tsx scripts/check-supply-chain.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run policy:verify && npm run version:verify && npm run terminology:check && npm run security:check-sql && npm run security:check-supply-chain && npm run docs:check"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@getbrevo/brevo": "^6.0.2",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
